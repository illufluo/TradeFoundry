# 只填写 OKX 官网“模拟交易”页面创建、仅勾选 Read 的 API Key。
# 复制为 .env 后填写；不要把 .env 发给他人或提交 Git。
OKX_DEMO_API_KEY=your_demo_api_key
OKX_DEMO_SECRET_KEY=your_demo_secret_key
OKX_DEMO_PASSPHRASE=your_demo_passphrase

# 按账户注册站点选择：global（全球站）、us（app.okx.com 美国/澳洲站）、
# eea（my.okx.com 欧洲站）。不能填写自定义 URL，不会自动换站重试。
OKX_SITE=global
OKX_TIMEOUT_SECONDS=15
